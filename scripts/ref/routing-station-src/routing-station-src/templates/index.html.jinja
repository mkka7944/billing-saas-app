                    <span style="color:#94a3b8; font-weight:800; margin-right:4px;">From:</span>
                    <input type="date" id="att-start-date" onchange="PerformanceLog.updateDate(this.value, 'start')" style="border:none; outline:none; font-family:inherit; font-weight:700; color:#475569; width:115px; cursor:pointer; font-size: 11px; padding: 4px 0;">
                    <div style="width:1px; height:14px; background:#e2e8f0; margin:0 6px;"></div>
                    <span style="color:#94a3b8; font-weight:800; margin-right:4px;">To:</span>
                    <input type="date" id="att-end-date" onchange="PerformanceLog.updateDate(this.value, 'end')" style="border:none; outline:none; font-family:inherit; font-weight:700; color:#475569; width:115px; cursor:pointer; font-size: 11px; padding: 4px 0;">
                </div>
                
                <button onclick="PerformanceLog.toggleRules()" class="admin-only btn-premium-sidebar" style="background:white; border:1px solid #e2e8f0; height:32px; padding:0 10px; border-radius:8px; display:flex; align-items:center; gap:6px; cursor:pointer; color:#64748b;">
                    <span class="material-icons-round" style="font-size:16px;">tune</span>
                    <span style="font-weight:800; font-size:11px;">Rules</span>
                </button>

                <button onclick="PerformanceLog.exportCSV()" class="admin-only btn-premium-sidebar" style="background:#10b981; border:none; height:32px; padding:0 12px; border-radius:8px; display:flex; align-items:center; gap:6px; cursor:pointer; color:white;">
                    <span class="material-icons-round" style="font-size:16px;">file_download</span>
                    <span style="font-weight:800; font-size:11px;">Export</span>
                </button>
            </div>

            <button onclick="PerformanceLog.close()" class="perf-close-btn" style="background:#f1f5f9; border:none; border-radius:50%; width:32px; height:32px; display:flex; align-items:center; justify-content:center; cursor:pointer; color:#94a3b8;">
                <span class="material-icons-round" style="font-size: 18px;">close</span>
            </button>
        </div>

        <!-- Admin Rules Panel -->
        <div id="perf-rules-panel" class="admin-only" style="display:none; padding:12px 20px; background:#f1f5f9; border-bottom:1px solid #e2e8f0; gap:16px; flex-wrap:wrap;">
            <!-- Performance Rules -->
            <div style="display:flex; align-items:center; gap:12px; border-right:2px solid #e2e8f0; padding-right:16px;">
                <div style="display:flex; align-items:center; gap:6px;">
                    <label style="font-size:9px; font-weight:800; color:#64748b; text-transform:uppercase;">Target:</label>
                    <input type="number" id="rule-target" onchange="PerformanceLog.updateRule('target', this.value)" style="width:50px; padding:4px; border:1px solid #cbd5e1; border-radius:4px; font-weight:700; font-size:11px;">
                </div>
                <div style="display:flex; align-items:center; gap:6px;">
                    <label style="font-size:9px; font-weight:800; color:#64748b; text-transform:uppercase;">PM:</label>
                    <input type="number" id="rule-pm" onchange="PerformanceLog.updateRule('pm', this.value)" style="width:50px; padding:4px; border:1px solid #cbd5e1; border-radius:4px; font-weight:700; font-size:11px;">
                </div>
                <div style="display:flex; align-items:center; gap:6px;">
                    <label style="font-size:9px; font-weight:800; color:#64748b; text-transform:uppercase;">Idle:</label>
                    <input type="number" id="rule-idle" onchange="PerformanceLog.updateRule('idle', this.value)" style="width:50px; padding:4px; border:1px solid #cbd5e1; border-radius:4px; font-weight:700; font-size:11px;">
                </div>
            </div>

            <!-- Geo Filters -->
            <div style="display:flex; align-items:center; gap:10px; flex-wrap: wrap;">
                <select id="perf-filter-dist" onchange="PerformanceLog.updateFilter('dist', this.value)" style="padding:4px 8px; border:1px solid #cbd5e1; border-radius:4px; font-weight:700; font-size:11px; color:#475569; background:white;"></select>
                <select id="perf-filter-tehsil" onchange="PerformanceLog.updateFilter('tehsil', this.value)" style="padding:4px 8px; border:1px solid #cbd5e1; border-radius:4px; font-weight:700; font-size:11px; color:#475569; background:white;"></select>
                <select id="perf-filter-mc" onchange="PerformanceLog.updateFilter('mc', this.value)" style="padding:4px 8px; border:1px solid #cbd5e1; border-radius:4px; font-weight:700; font-size:11px; color:#475569; background:white;"></select>
            </div>
        </div>

        <!-- Table Container -->
        <div id="log-body" class="stats-table-container" style="flex:1; overflow-y:auto; padding:0;"></div>
    </div>
</div>

